{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./ws:*)",
      "Bash(python3 tools/ws/ws.py:*)",
      "Bash(python3 research/run.py:*)",
      "Bash(python3 research/atlas.py:*)",
      "Bash(python3 research/portfolio.py --dry-run:*)",
      "Bash(python3 research/portfolio.py --preview-scout:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(gh auth status:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",
      "Edit(/.ws/**)",
      "Write(/.ws/**)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh auth token:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.workstead/nostr.json)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
