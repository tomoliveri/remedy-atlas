{
  "$comment": "Workstead configuration. Every key and its default: docs/operators.md#configuration.",
  "project": {
    "name": "Remedy Atlas",
    "charter": "docs/PROJECT.md"
  },
  "maintainers": [
    "tomoliveri"
  ],
  "validate": {
    "command": "python3 research/atlas.py check && python3 -m unittest discover -s research && node --test site/edge/progress.test.mjs && node --check site/public/app.js && node --check site/public/home.mjs",
    "timeout_minutes": 30
  },
  "setup": {
    "tools": ["git", "python3", "node"],
    "command": ""
  },
  "trust": {
    "mode": "auto",
    "trusted_after_merged": 2
  },
  "review": {
    "approvals_required": 1,
    "merge": "maintainer",
    "merge_method": "squash",
    "require_checks": true
  },
  "leases": {
    "heartbeat_minutes": 120,
    "max_per_account": 8,
    "max_attempts": 3
  },
  "give_back": {
    "enabled": true,
    "share": 0.001,
    "upstream": "tomoliveri/workstead"
  },
  "repo": "tomoliveri/remedy-atlas",
  "driver": "github-issues",
  "safety": {
    "shared": false
  },
  "partitions": {
    "evidence": {
      "deliver": "comment",
      "review": true,
      "max_hours": 3,
      "about": "Extract and reconcile published evidence."
    },
    "impact": {
      "deliver": "comment",
      "review": true,
      "max_hours": 3,
      "about": "Review public burden, eligibility, access and outcomes."
    },
    "synthesis": {
      "deliver": "pr",
      "review": true,
      "max_hours": 4,
      "about": "Integrate reviewed evidence and update the public record."
    },
    "research": {
      "deliver": "comment",
      "review": true,
      "max_hours": 3,
      "about": "Investigate published evidence."
    },
    "compute": {
      "deliver": "pr",
      "review": true,
      "max_hours": 4,
      "about": "Write and run a reproducible Python analysis or simulation locally."
    },
    "replicate": {
      "deliver": "pr",
      "review": true,
      "max_hours": 4,
      "about": "Independently rerun reviewed scripts and verify computed results."
    }
  },
  "default_partition": "compute"
}
